# Monogram 环境变量样例：复制为 .env 后按需填写（.env 不入库）
# 用法：forge script script/DeployM.s.sol --rpc-url $RPC --broadcast
#
# 注意（脚本实现的硬约束）：
#   * 所有 CSV 列表（ASSETS / CUSTODIANS / CHAINLINK_FEEDS / PYTH_FEED_IDS /
#     OPERATORS / GATEKEEPERS）**不要带空格**，逗号紧接下一项。
#     `_parseAddresses` 要求每项恰好 42 字符，写成 "0xA, 0xB" 会 revert("invalid address length")。
#   * 各列表顺序逐位对齐 ASSETS。

# ---------- 通用 ----------
# 部署者/签名方私钥（本地测试可直接用 anvil 默认账户私钥）
PRIVATE_KEY=
# 目标链 RPC（也可用 --rpc-url 直接传）
RPC_URL=https://sepolia.gateway.tenderly.co

# ---------- 链上地址（按目标链填写，见 ADR-0008） ----------
# 真链上传 WETH 地址；本地彩排留空并置 DEPLOY_WETH=true 自动部署 WETH9
WETH_ADDRESS=
# Pyth 合约地址（务必用 Pyth 升级版合约，见 ADR-0008「Pyth Core 升级」）
PYTH_ADDRESS=

# ---------- 部署：资产与托管 ----------
# 受支持的抵押资产（CSV，无空格）；至少一项，否则脚本 revert("ASSETS required")
ASSETS=
# custodian 路由地址（CSV，无空格）；留空只告警，但 mint 的 Route 会失败
CUSTODIANS=
# per-block 限额（默认 1000000 ether）
MAX_MINT_PER_BLOCK=1000000000000000000000000
MAX_REDEEM_PER_BLOCK=1000000000000000000000000
# 本地彩排 true（自部署 WETH9）；真链 false 并填 WETH_ADDRESS
DEPLOY_WETH=true
# 白名单单向棘轮（见 #11）：测试网保持 false；主网部署后单独置 true，不可逆
ENABLE_WHITELIST=false
# 可选：部署后请求移交 DEFAULT_ADMIN 给多签（多签需再调 acceptAdmin() 完成）
MINTING_ADMIN=

# ---------- 部署：sM ----------
STAKEDM_NAME=Staked Monogram
STAKEDM_SYMBOL=sM
# 冷却期秒数；不设置则保持构造函数默认值（90 天）
# 填 0 = 关闭冷却期（恢复标准 ERC-4626 提款）；超过 90 天会被合约 revert(InvalidCooldown)
# 超过 uint24 上限（16777215）会被脚本 require 拦下——否则静默截断可能把冷却期变成 0
STAKEDM_COOLDOWN_SECONDS=

# ---------- 部署：角色 ----------
# MINTER/REDEEMER/OPERATOR 持有者（CSV，无空格）；留空则默认授予部署者（仅测试网便利）
OPERATORS=
# GATEKEEPER 持有者（CSV，无空格）；留空则默认授予部署者
GATEKEEPERS=

# ---------- 部署：预言机配置 ----------
# Chainlink feed 地址（CSV，无空格，与 ASSETS 等长）；留空则跳过整个预言机配置步骤
CHAINLINK_FEEDS=
# Pyth feed id（bytes32 hex，CSV）；留空则只走 Chainlink
PYTH_FEED_IDS=
# 价格最大年龄（秒，默认 24h）与最大偏差（bps，默认 500）；生产值按 ADR-0008 由治理设定
ORACLE_MAX_AGE=86400
ORACLE_MAX_DEVIATION_BPS=500

# ---------- 部署后校验（script/PostDeployCheck.s.sol） ----------
# 把上面部署时用的同一份变量再喂给校验脚本，它会用预期值回头核对链上现实。
# 用法：forge script script/PostDeployCheck.s.sol --rpc-url $RPC
M_ADDRESS=
PRICE_FEED_ADDRESS=
# MINTING_ADDRESS 在下方签名服务段落定义，两脚本共用
STAKEDM_ADDRESS=
DISTRIBUTOR_ADDRESS=
# 期望的最终 admin / owner（多签）。未设置时视为部署者（仅测试网）
ADMIN_ADDRESS=
# none（默认）= 全部 admin/owner 仍是部署者；pending = 已请求移交待多签接受；done = 多签已接手
EXPECT_ADMIN_HANDOVER=none
# 部署者地址：不设 PRIVATE_KEY 时用（只读校验不需要私钥）
DEPLOYER_ADDRESS=
# 分发器之外的 REWARDER（如热钱包）；PROBE_ADDRESSES = 额外要核对的地址
REWARDERS=
PROBE_ADDRESSES=
# 白名单已开启时逐个核对已在名单内（CSV，无空格）
WHITELISTED_BENEFACTORS=
# 合约默认值 = 500bps（部署脚本不设置该参数）；改了就用这里同步预期
EXPECT_MAX_PRICE_DEVIATION_BPS=500
# 真链上保持 true：它会真的调一次 getPrice，用于拓出预言机接线/陈旧价格问题
CHECK_ORACLE_LIVENESS=true
# 部署后立刻校验保持 true；若已有存款/奖励再复跑则置 false
EXPECT_FRESH_VAULT=true

# ---------- 链下签名服务原型（script/E2EMint.s.sol） ----------
# operator 私钥（必须持有 MINTER_ROLE），与 PRIVATE_KEY（benefactor/签名方）分开
OPERATOR_KEY=
MINTING_ADDRESS=
CUSTODIAN_ADDRESS=
# 抵押资产地址（本地彩排即 DEPLOY_WETH 出来的 WETH9）
COLLATERAL_ASSET=
# 抵押数量（wei，默认 0.01 ether）
AMOUNT=10000000000000000
# 订单 nonce（默认 1）；重复运行需递增，否则触发 NonceBitmap 重放保护
NONCE=1
# 订单号（默认 e2e-mint）
ORDER_ID=e2e-mint

# ---------- 手动签单（script/EIP712Helper.s.sol，只算摘要/签名，不广播） ----------
# BENEFACTOR / BENEFICIARY / COLLATERAL_ASSET / MINTING_ADDRESS 复用上面的变量
BENEFACTOR=
BENEFICIARY=
COLLATERAL_AMOUNT=
M_AMOUNT=
EXPIRY_SECONDS=3600
IS_MINT=true
